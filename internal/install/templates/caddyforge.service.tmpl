[Unit]
Description=caddyforge – Caddy WebUI und Verwalter
Documentation=file:///etc/caddyforge/state.json
After=network-online.target caddy.service
Wants=caddy.service

[Service]
# Type=simple, nicht notify: caddyforge spricht den sd_notify-Prozess noch nicht,
# und eine Type=notify-Unit ohne READY=1 killt systemd bei TimeoutStartSec.
Type=simple
ExecStart={{ .ForgeBin }} serve
Restart=on-failure
RestartSec=5
WorkingDirectory=/
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
# caddyforge schreibt Caddyfile, Env-Datei und ruft systemctl/caddy:
ReadWritePaths=/etc/caddyforge /etc/caddy /var/lib/caddyforge
User=root
Group=root

[Install]
WantedBy=multi-user.target
