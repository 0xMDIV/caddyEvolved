[Unit]
Description=Caddy
Documentation=https://caddyserver.com/docs/
After=network-online.target
Wants=network-online.target

[Service]
User={{ .User }}
Group={{ .Group }}
Type=notify
EnvironmentFile=-{{ .EnvFile }}
ExecStart={{ .CaddyBin }} run --config {{ .Caddyfile }} --adapter caddyfile
ExecReload={{ .CaddyBin }} reload --config {{ .Caddyfile }} --force
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=full
ReadWritePaths={{ .StateDir }}
AmbientCapabilities={{ if .BindLowPort }}CAP_NET_BIND_SERVICE {{ end }}CAP_KILL

[Install]
WantedBy=multi-user.target
