    {
      "id": "cloudflare",
      "module": "github.com/caddy-dns/cloudflare",
      "name": "Cloudflare",
      "category": "dns",
      "subcat": "dns01",
      "registers": "dns.provider cloudflare",
      "standard": true,
      "license": "Apache-2.0",
      "docs": "https://github.com/caddy-dns/cloudflare",
      "note": "lego-basiert: liest CF_API_TOKEN auch ohne Interpolation in der Caddyfile.",
      "env": [
        {
          "name": "CF_API_TOKEN",
          "label": "API-Token",
          "help": "Cloudflare → Mein Profil → API-Token → „Zone-DNS bearbeiten“-Vorlage, Zone = deine Domain",
          "required": true,
          "secret": true,
          "opt": "api_token"
        },
        {
          "name": "CF_ZONE_TOKEN",
          "label": "Zone-Token (optional)",
          "required": false,
          "secret": true,
          "opt": "zone_token"
        }
      ]
    },
    {
